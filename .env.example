# ==============================================================================
# FX Signal Reader - Environment Configuration (USD/JPY & EUR/USD)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Default Currency Pair
# Supported pairs: USD/JPY, EUR/USD (default: USD/JPY)
FX_PAIR=USD/JPY

# SQLite Database Storage
# Absolute or relative path to the SQLite database file.
# Defaults automatically based on FX_PAIR:
#   - USD/JPY -> data/usdjpy_signals.db (or /app/data/usdjpy_signals.db in Docker)
#   - EUR/USD -> data/eurusd_signals.db (or /app/data/eurusd_signals.db in Docker)
# Leave unset or set explicitly if overriding:
FX_DB_PATH=

# Federal Reserve Economic Data (FRED) API Key
# Optional: Used for official US 2Y (DGS2) and US 10Y (DGS10) yield benchmarking.
# If omitted or empty, the collector falls back to Yahoo Finance (^TNX) and MoF JGB 10Y.
# Obtain a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Nasdaq Data Link API Key
# Optional: Used by the external `nasdaq-data-link` MCP server (`mcp_servers.json`).
NASDAQ_DATA_LINK_API_KEY=

# Collection Polling Cadences (in seconds)
# RSS News & Verbal Intervention Feed Polling Interval (default: 300s / 5 minutes)
POLL_INTERVAL_NEWS=300

# Market Ticks & Sovereign Yield Polling Interval (default: 900s / 15 minutes)
POLL_INTERVAL_TICKS=900

# Forex Factory Economic Calendar Polling Interval (default: 86400s / 24 hours)
POLL_INTERVAL_CALENDAR=86400

# Telegram Remote Approval Gate & Daily Summary (Optional)
# Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN,
# then message your bot and run `fx-pipeline --telegram-test` to verify or auto-discover TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT=300
TELEGRAM_SUMMARY_TIME_JST=09:00

# Application Logging Level
# Choices: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
