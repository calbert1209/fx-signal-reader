# ==============================================================================
# USD/JPY Signal Reader - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the container:
#   cp .env.example .env
#
# SQLite Database Storage
# Absolute path inside the container to the SQLite database file.
# Default: /app/data/usdjpy_signals.db (bind-mounted to host ./data)
FX_DB_PATH=/app/data/usdjpy_signals.db

# Federal Reserve Economic Data (FRED) API Key
# Optional: Used for official US 2Y (DGS2) and US 10Y (DGS10) yield benchmarking.
# If omitted or empty, the collector falls back to Yahoo Finance (^TNX) and MoF JGB 10Y.
# Obtain a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Nasdaq Data Link API Key
# Optional: Used by the external `nasdaq-data-link` MCP server (`mcp_servers.json`).
NASDAQ_DATA_LINK_API_KEY=

# Collection Polling Cadences (in seconds)
# RSS News & Verbal Intervention Feed Polling Interval (default: 300s / 5 minutes)
POLL_INTERVAL_NEWS=300

# Market Ticks & Sovereign Yield Polling Interval (default: 900s / 15 minutes)
POLL_INTERVAL_TICKS=900

# Forex Factory Economic Calendar Polling Interval (default: 86400s / 24 hours)
POLL_INTERVAL_CALENDAR=86400

# Application Logging Level
# Choices: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
